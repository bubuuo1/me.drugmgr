# Supabase 연동 환경변수 예시 (공개용 anon key만 사용)
# 1. supabase.com 프로젝트 > Settings > API 에서 값을 복사
# 2. 이 파일을 .env.local 로 복사하고 값을 채운다
# 3. .env.local은 git에 커밋하지 않는다 (service role key는 절대 넣지 말 것)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY