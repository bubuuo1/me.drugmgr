# 운영/로컬 개발용 Supabase 공개 설정
# 이 파일을 .env.local로 복사한 뒤 실제 프로젝트 값을 입력한다.
# publishable/anon key는 브라우저 공개용이지만 service role key는 절대 넣지 않는다.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# 기존 Supabase 프로젝트의 legacy anon key를 사용할 때만 위 publishable key 대신 설정한다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-LEGACY-ANON-KEY

# Playwright 전용. CI와 playwright.config.ts가 true로 설정한다.
# 운영 또는 일반 로컬 개발의 .env.local에는 설정하지 않는다.
# NEXT_PUBLIC_USE_MOCK_DB=true
