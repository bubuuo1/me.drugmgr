# 운영/로컬 개발용 Supabase 공개 설정
# 이 파일을 .env.local로 복사한 뒤 실제 프로젝트 값을 입력한다.
# publishable/anon key는 브라우저 공개용이지만 service role key는 절대 넣지 않는다.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Google OAuth Client ID/Secret은 이 파일에 넣지 않는다.
# Supabase Dashboard > Authentication > Providers > Google에만 저장한다.
# 앱 callback은 현재 브라우저 origin의 /auth/callback을 사용하므로 별도 SITE_URL 환경변수는 없다.

# 기존 Supabase 프로젝트의 legacy anon key를 사용할 때만 위 publishable key 대신 설정한다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-LEGACY-ANON-KEY

# PWA Web Push 설정. VAPID 키 쌍은 한 번 생성한 뒤 계속 같은 값을 사용한다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=https://me-drugmgr.vercel.app

# Supabase Cron이 Vercel 발송 API를 호출할 때 사용하는 임의의 긴 비밀값이다.
PUSH_DISPATCH_SECRET=YOUR-RANDOM-DISPATCH-SECRET

# Playwright 전용. CI와 playwright.config.ts가 true로 설정한다.
# 운영 또는 일반 로컬 개발의 .env.local에는 설정하지 않는다.
# NEXT_PUBLIC_USE_MOCK_DB=true
